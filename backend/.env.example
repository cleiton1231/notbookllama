# Endpoints do llama-server (cada modelo pode rodar em uma porta separada)
LLAMA_CHAT_URL=http://127.0.0.1:8080
LLAMA_EMBED_URL=http://127.0.0.1:8081
LLAMA_RERANK_URL=http://127.0.0.1:8082

# Armazenamento e RAG
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Hiperparâmetros RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=24
TOP_K_RERANK=12
MIN_RELEVANCE_SCORE=0.05
MAX_CONTEXT_TOKENS=6000

# Segurança e CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=50

# Timeouts HTTP para llama-server (segundos)
CHAT_TIMEOUT=120.0
EMBED_TIMEOUT=30.0
RERANK_TIMEOUT=30.0

# OCR (opcional): não há variáveis de ambiente.
# Instale no sistema: tesseract (+ idiomas, ex. por/eng) e pdftoppm (poppler-utils).
# Sem essas ferramentas, PDFs com texto continuam funcionando; PDFs escaneados
# recebem aviso diagnóstico em vez de falhar a ingestão.
