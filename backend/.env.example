LLAMA_RERANK_URL=http://127.0.0.1:8082

# Armazenamento e RAG
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Hiperparâmetros RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=60
TOP_K_RETRIEVAL=12
TOP_K_RERANK=4
MAX_CONTEXT_TOKENS=3000
